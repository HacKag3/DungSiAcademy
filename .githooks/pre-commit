#!/bin/sh
# Pre-commit hook: rigenera gli html dai template prima di ogni commit,
# cosi' non si rischia di committare pagine non allineate a
# seo-data.json / config.js / pages_template.
#
# Attivato una tantum per clone con:
#   git config core.hooksPath .githooks

echo "Rigenero gli html da pages_template..."
node build-seo.mjs

if [ $? -ne 0 ]; then
    echo "build-seo.mjs ha fallito: commit annullato."
    exit 1
fi

# Se aggiungi una pagina nuova in seo-data.json, aggiungi qui anche il
# suo file di output, altrimenti il commit non la includerebbe.
git add index.html contacts.html whoweare.html privacy.html cookie.html

echo "Build completata, file rigenerati inclusi nel commit."
exit 0
